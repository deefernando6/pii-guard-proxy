# Configuration for the pii-guard-proxy systemd service.
# Restart the service after changes:  sudo systemctl restart pii-guard-proxy
#
#PII_GUARD_PORT=8765
#PII_GUARD_HEADLESS_ACTION=anonymize     # anonymize | accept | decline
#PII_GUARD_VERBOSE=1
#PII_GUARD_REVEAL=true
#PII_GUARD_MITM=true
#
# When the service starts/stops the Chromium-family managed policy is
# applied/removed automatically. By default we SIGTERM running browsers
# so they pick up the new state on next launch (otherwise Chrome keeps
# the in-memory policy and "no internet" persists after a stop). Set
# this to false to suppress the browser restart.
#PII_GUARD_KILL_BROWSERS_ON_POLICY_CHANGE=true
#
# Response-handling mode:
#   default (unset/false): full-response buffering. Holds the whole LLM
#     reply in memory before running placeholder revert and shipping it.
#     Reliable revert; user sees the full response at once.
#   true: streaming mode. Flushes chunks as they arrive with
#     chunk-boundary heuristics. Lower latency, but can leave some
#     placeholders un-reverted in edge cases.
#PII_GUARD_STREAMING=false
