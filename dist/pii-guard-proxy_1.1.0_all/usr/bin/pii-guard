#!/bin/bash
# pii-guard — control & inspect the local PII Guard proxy.
set -eu

CONFIG_DIR=/etc/pii-guard
RUNTIME_ENV="$CONFIG_DIR/runtime.env"
SERVICE=pii-guard-proxy.service

err()   { echo "error: $*" >&2; exit 1; }
need_root() {
  [ "$(id -u)" -eq 0 ] || err "this command must be run as root (try: sudo pii-guard $*)"
}

usage() {
  cat <<EOF
Usage: pii-guard <subcommand> [args]

Toggle behaviour:
  pii-guard placeholder-replace enable    Revert [PHONE_1] etc. to real values in LLM responses (default).
  pii-guard placeholder-replace disable   Leave placeholders visible in responses (proves anonymization).
  pii-guard placeholder-replace status    Show whether replacement is enabled or disabled.

Inspection:
  pii-guard status                        Show service health + active modes (warns if env is stale).
  pii-guard modes                         List which proxy modes (claude-code / https-proxy / browser) are active.
  pii-guard log         [-n N]            Show the last N proxy log lines (default 50).
  pii-guard log -f                        Follow the live proxy log.

Service:
  sudo pii-guard start                    Start the proxy.
  sudo pii-guard stop                     Stop the proxy. Prints a clear warning about stale shell env vars.
  sudo pii-guard restart                  Restart the proxy.

Reconfiguration:
  pii-guard reconfigure                   Re-run the install-time mode multiselect.

Detection engine:
  pii-guard ml-status                     Show GLiNER PII Small INT8 model status.
  pii-guard redownload-model              Re-fetch the GLiNER model files (~50 MB) if the original download failed.

Cert helpers:
  pii-guard trust-chrome                  Add the proxy CA to the current user's Chrome NSS DB.
EOF
  exit 1
}

# ─── runtime env file helpers (CLI-managed, distinct from /etc/default/pii-guard-proxy)
read_var() {
  # echo current value of $1 from runtime.env, or empty if unset
  [ -f "$RUNTIME_ENV" ] || return 0
  grep -E "^$1=" "$RUNTIME_ENV" | tail -1 | cut -d= -f2- || true
}

write_var() {
  # write_var KEY VALUE — atomically replace or add the assignment in runtime.env
  need_root "$@"
  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp="$(mktemp -p "$CONFIG_DIR")"
  if [ -f "$RUNTIME_ENV" ]; then
    grep -vE "^$1=" "$RUNTIME_ENV" > "$tmp" || true
  fi
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  chmod 0644 "$tmp"
  mv "$tmp" "$RUNTIME_ENV"
}

restart_service() {
  systemctl restart "$SERVICE" \
    || err "service restart failed — check 'journalctl -u $SERVICE'"
}

is_truthy() {
  case "$(echo "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    ''|true|on|yes|1) return 0 ;;
    *) return 1 ;;
  esac
}

# ─── subcommands

cmd_placeholder_replace() {
  case "${1:-status}" in
    enable|on|true)
      write_var PII_GUARD_REVEAL true
      restart_service
      echo "Placeholder replacement: ENABLED."
      echo "The proxy will swap placeholders back to real values in LLM responses."
      ;;
    disable|off|false)
      write_var PII_GUARD_REVEAL false
      restart_service
      echo "Placeholder replacement: DISABLED."
      echo "Placeholders like [PHONE_1] will remain visible in LLM responses (proves the LLM only saw placeholders)."
      ;;
    status)
      local cur
      cur="$(read_var PII_GUARD_REVEAL)"
      if is_truthy "$cur"; then
        echo "Placeholder replacement: ENABLED  (PII_GUARD_REVEAL=${cur:-true})"
      else
        echo "Placeholder replacement: DISABLED (PII_GUARD_REVEAL=$cur)"
      fi
      ;;
    *)
      err "unknown action '$1' — use enable | disable | status"
      ;;
  esac
}

cmd_status() {
  systemctl status "$SERVICE" --no-pager 2>&1 | head -8
  echo
  cmd_modes
  echo
  cmd_placeholder_replace status
  # Detect the "service down but my shell still has stale env vars"
  # state — most common cause of "Claude Code can't connect" reports.
  if ! systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
    if [ -n "${ANTHROPIC_BASE_URL:-}" ] || [ -n "${HTTPS_PROXY:-}" ]; then
      echo
      echo "⚠  The proxy service is NOT running, but THIS shell still has"
      echo "   ANTHROPIC_BASE_URL / HTTPS_PROXY pointing at it. Claude Code"
      echo "   and other LLM SDKs in this shell will fail with"
      echo "   'connection refused' until you either:"
      echo "     • run \`sudo pii-guard start\` to bring the proxy back, OR"
      echo "     • unset the env vars in THIS shell:"
      echo "       unset ANTHROPIC_BASE_URL HTTPS_PROXY HTTP_PROXY \\"
      echo "             NO_PROXY NODE_EXTRA_CA_CERTS"
      echo "     • or open a new terminal (it'll be clean)."
    fi
  fi
}

# Visible-on-terminal wrappers for systemctl stop/start/restart. The
# systemd ExecStopPost / ExecStartPost hooks log recovery hints to the
# journal, which most users never read. These wrappers print the same
# hints directly to the user's terminal so they actually see them.
banner_stale_env() {
  cat <<'BANNER'

⚠  The proxy is now stopped, but any shell that was already open still
   has ANTHROPIC_BASE_URL / HTTPS_PROXY pointing at the dead proxy.
   Claude Code and other LLM SDKs in those shells will fail with
   'connection refused' until you either:
     • run `sudo pii-guard start` to bring the proxy back, OR
     • unset the env vars in every shell you care about:
       unset ANTHROPIC_BASE_URL HTTPS_PROXY HTTP_PROXY \
             NO_PROXY NODE_EXTRA_CA_CERTS
     • or open new terminals (they'll be clean — /etc/profile.d entries
       have been removed by the systemd hook).

BANNER
}

cmd_stop() {
  need_root "$@"
  systemctl stop "$SERVICE" \
    || err "service stop failed — check 'journalctl -u $SERVICE'"
  echo "Stopped pii-guard-proxy.service."
  banner_stale_env
}

cmd_start() {
  need_root "$@"
  systemctl start "$SERVICE" \
    || err "service start failed — check 'journalctl -u $SERVICE'"
  echo "Started pii-guard-proxy.service."
  echo "Existing shells already have ANTHROPIC_BASE_URL / HTTPS_PROXY set,"
  echo "so they'll route through the proxy immediately. New shells will"
  echo "pick up the env once /etc/profile is re-sourced (open a new shell)."
}

cmd_restart() {
  need_root "$@"
  systemctl restart "$SERVICE" \
    || err "service restart failed — check 'journalctl -u $SERVICE'"
  echo "Restarted pii-guard-proxy.service."
}

cmd_modes() {
  echo "Active modes:"
  [ -f /etc/profile.d/pii-guard-claude-code.sh ] \
    && echo "  ✓ claude-code  (ANTHROPIC_BASE_URL set system-wide)" \
    || echo "  ✗ claude-code"
  [ -f /etc/profile.d/pii-guard-https-proxy.sh ] \
    && echo "  ✓ https-proxy  (HTTPS_PROXY set system-wide)" \
    || echo "  ✗ https-proxy"
  if [ -f /etc/opt/chrome/policies/managed/pii-guard.json ] \
     || [ -f /etc/chromium/policies/managed/pii-guard.json ]; then
    echo "  ✓ browser      (Chromium-family managed policy + CA in NSS)"
  else
    echo "  ✗ browser"
  fi
}

cmd_log() {
  case "${1:-}" in
    -f|--follow)
      journalctl -u "$SERVICE" -f
      ;;
    -n)
      [ -n "${2:-}" ] || err "-n needs a number"
      journalctl -u "$SERVICE" --no-pager -n "$2"
      ;;
    "")
      journalctl -u "$SERVICE" --no-pager -n 50
      ;;
    *)
      err "unknown log option '$1'"
      ;;
  esac
}

cmd_reconfigure() {
  need_root "$@"
  dpkg-reconfigure pii-guard-proxy
}

cmd_trust_chrome() {
  if [ ! -x /usr/bin/pii-guard-trust-chrome ]; then
    err "/usr/bin/pii-guard-trust-chrome not found — is the package installed?"
  fi
  exec /usr/bin/pii-guard-trust-chrome
}

ML_MARKER=/etc/pii-guard/ml-detection-enabled
ML_MODEL_DIR=/var/lib/pii-guard/models/gliner-pii-small

cmd_ml_status() {
  if [ -f "$ML_MARKER" ]; then
    echo "Detection mode: HYBRID  (regex + GLiNER PII Small)"
  else
    echo "Detection mode: REGEX-ONLY"
  fi
  if [ -f "$ML_MODEL_DIR/onnx/model_quantized.onnx" ]; then
    echo "Model present:  yes  ($ML_MODEL_DIR, $(du -sh "$ML_MODEL_DIR" 2>/dev/null | cut -f1))"
  else
    echo "Model present:  no   (run: sudo pii-guard ml-enable)"
  fi
  if [ -d /usr/lib/pii-guard-proxy/node_modules/@huggingface/transformers ]; then
    echo "transformers.js: installed"
  else
    echo "transformers.js: not installed"
  fi
}

cmd_redownload_model() {
  need_root "$@"
  install -d -m 0755 -o pii-guard -g pii-guard /var/lib/pii-guard/models
  echo "Re-fetching GLiNER PII Small INT8 model + transformers.js (~50 MB)..."
  if [ -x /usr/lib/pii-guard-proxy/install-ml.sh ]; then
    /usr/lib/pii-guard-proxy/install-ml.sh \
      || err "model download failed — fix connectivity then retry"
  else
    err "/usr/lib/pii-guard-proxy/install-ml.sh missing — reinstall the package"
  fi
  restart_service
  echo "Done. Verify with: pii-guard ml-status"
}

case "${1:-}" in
  placeholder-replace) shift; cmd_placeholder_replace "$@" ;;
  status)              cmd_status ;;
  modes)               cmd_modes ;;
  log)                 shift; cmd_log "$@" ;;
  start)               cmd_start "$@" ;;
  stop)                cmd_stop "$@" ;;
  restart)             cmd_restart "$@" ;;
  reconfigure)         cmd_reconfigure ;;
  ml-status)           cmd_ml_status ;;
  redownload-model)    cmd_redownload_model "$@" ;;
  trust-chrome)        cmd_trust_chrome ;;
  ""|-h|--help|help)   usage ;;
  *)                   err "unknown subcommand '$1' (run: pii-guard --help)" ;;
esac
